# Copy to .env and adjust for your machine / emulator.
# Web app uses VITE_API_URL; mobile uses EXPO_PUBLIC_API_URL (same server, same /api paths).

# Local API (iOS simulator / web)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/api

# Android emulator → host machine
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# Physical phone on same Wi‑Fi (use your PC's LAN IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/api
